# Environment variables for the webapp (Railway / Docker / local .env).
# Streamlit reads st.secrets first; these env vars are the fallback.
# Copy to .env in the repo root and fill in real values (never commit .env).

# Webapp auth
WEBAPP_PASSWORD=change-me

# Google credentials (base64-encoded service account JSON)
GOOGLE_CREDENTIALS_B64=

# Course Google Sheet IDs (one per course key in config/attendance.yaml)
CRASH_SHEET_ID=
MAIN_SHEET_ID=
G9_SHEET_ID=
G10_SHEET_ID=

# Free.ai API key (primary OCR provider)
FREEAI_API_KEY=

# Gemini API key (fallback OCR provider)
GEMINI_API_KEY=

# Zoom API credentials (optional)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

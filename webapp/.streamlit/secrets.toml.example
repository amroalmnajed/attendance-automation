# Copy this file to webapp/.streamlit/secrets.toml and fill in real values.
# DO NOT commit secrets.toml — it is in .gitignore.
# On Streamlit Community Cloud, add these as app secrets in the dashboard instead.

# --------------------------------------------------------------------------
# Webapp auth
# --------------------------------------------------------------------------
WEBAPP_PASSWORD = "change-me"

# --------------------------------------------------------------------------
# Google credentials
# --------------------------------------------------------------------------
# Base64-encoded contents of your service-account JSON key file.
# Generate: base64 -i your-key.json | tr -d '\n'
GOOGLE_CREDENTIALS_B64 = ""

# --------------------------------------------------------------------------
# Course Google Sheet IDs  (one per course key in config/attendance.yaml)
# --------------------------------------------------------------------------
CRASH_SHEET_ID = ""
MAIN_SHEET_ID  = ""
G9_SHEET_ID    = ""
G10_SHEET_ID   = ""

# --------------------------------------------------------------------------
# Free.ai API key (primary OCR provider — GOT-OCR 2.0)
# --------------------------------------------------------------------------
FREEAI_API_KEY = ""

# --------------------------------------------------------------------------
# Gemini API key (fallback OCR provider — used when free.ai hits token limit)
# --------------------------------------------------------------------------
GEMINI_API_KEY = ""

# --------------------------------------------------------------------------
# Zoom API credentials (optional — needed only for the /zoom_fetch screen)
# --------------------------------------------------------------------------
ZOOM_ACCOUNT_ID    = ""
ZOOM_CLIENT_ID     = ""
ZOOM_CLIENT_SECRET = ""

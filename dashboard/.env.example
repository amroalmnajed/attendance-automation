# ── Google service account (base64-encoded JSON) ─────────────────────
# Generate once:
#   base64 -w0 service_account.json > sa.b64    (Linux)
#   base64 -i service_account.json              (macOS — copy the output)
GOOGLE_CREDENTIALS_B64=

# ── Per-course sheet IDs (leave blank to hide a course) ──────────────
CRASH_SHEET_ID=
MAIN_SHEET_ID=
G9_SHEET_ID=
G10_SHEET_ID=

# ── Optional overrides ───────────────────────────────────────────────
# Tab holding the main attendance grid (default: Attendance)
CRASH_TAB=Attendance
MAIN_TAB=Attendance
G9_TAB=Attendance
G10_TAB=Attendance

# Tab holding the review queue (default: ReviewQueue)
REVIEW_TAB=ReviewQueue

# Regex matching session column headers (default: ^Session\s+\d+$)
SESSION_HEADER_PATTERN=^Session\s+\d+$

# Dashboard password (single-user gate)
DASHBOARD_PASSWORD=change-me

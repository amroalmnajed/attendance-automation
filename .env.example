# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git

# Google Service Account
GOOGLE_APPLICATION_CREDENTIALS=your-service-account-key.json

# Google Sheet IDs
CRASH_SHEET_ID=<your-crash-sheet-id>
MAIN_SHEET_ID=<your-main-sheet-id>
G10_SHEET_ID=<your-g10-sheet-id>
G9_SHEET_ID=<your-g9-sheet-id>

# Gemini API
GEMINI_API_KEY=<your-gemini-api-key>

# Optional: Zoom API (for automated attendance)
ZOOM_ACCOUNT_ID=<your-zoom-account-id>
ZOOM_CLIENT_ID=<your-zoom-client-id>
ZOOM_CLIENT_SECRET=<your-zoom-client-secret>


# Optional: Additional Sheet IDs
INGEST_SHEET_ID=<optional-sheet-id-for-form-ingest>
INBOX_FOLDER_ID=<optional-drive-folder-id>
OPS_SHEET_ID=<optional-ops-sheet-id>

# Optional: Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=<your-app-password>
NOTIFY_TO=your-email@gmail.com
